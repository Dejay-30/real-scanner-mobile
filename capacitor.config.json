{
  "appId": "com.realscanner.app",
  "appName": "Real Scanner",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "url": "https://dejay-30.github.io/real-scanner-mobile/",
    "allowNavigation": [
      "dejay-30.github.io/*"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#070A13"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#070A13"
    }
  }
}